val %>% filter(Description%in% c("Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters","Average per capita household DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters","Per capita DVMT for urban households","Per capita DVMT for town households","Per capita DVMT for rural households","Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income less than 25K","Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income between 25K to 50K","Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income over 50K","Total DVMT of light-duty vehicles and heavy duty vehicles")) %>%
mutate(Description=case_when(
Description == "Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters" ~ "Total DVMT",
Description =="Average per capita household DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters" ~ "Average per capita household DVMT",
Description == "Per capita DVMT for urban households" ~ "Per capita DVMT for urban households",
Description == "Per capita DVMT for town households" ~ "Per capita DVMT for town households",
Description == "Per capita DVMT for rural households" ~ "Per capita DVMT for rural households",
Description == "Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income less than 25K" ~ "Total DVMT with hh income less than 32K",
Description == "Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income between 25K to 50K" ~ "Total DVMT with hh income between 32K to 64K",
Description == "Total DVMT (in owned and car service vehicles) of persons in households and non-institutional group quarters with hh income over 50K" ~ "Total DVMT with hh income over 64K",
Description == "Total DVMT of light-duty vehicles and heavy duty vehicles" ~ "Total DVMT of light-duty vehicles and heavy duty vehicles"
)) %>%
ggplot(aes(Description,percent_change1)) + geom_col() +coord_flip() + theme_minimal() +
scale_y_continuous(labels = scales::percent_format(accuracy=1)) +
ggtitle("VMT - Change 2015-2050 (AP22)") +
xlab("") + ylab("")
ggsave(path="plots",filename="VMT.jpg", width=9, height=4)
