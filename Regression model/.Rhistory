library(tidyverse)
library(tidycensus)
table <- get_acs(
geography = "block group",
variables = "B01001",
year = 2021,
state = "OR"
)
table <- get_acs(
geography = "block group",
variables = "B01001_001E",
year = 2021,
state = "OR"
)
View(table)
table2 <- table %>%
group_by(GEOID) %>%
summarize(estimate=sum(estimate, na.rm = T))
View(table2)
min(table2$estimate)
max(table2$estimate)
table2 <- table %>%
group_by(GEOID) %>%
summarize(estimate=sum(estimate, na.rm = T)) %>%
ungroup() %>%
filter(estimate > 0)
min(table2$estimate)
max(table2$estimate)
