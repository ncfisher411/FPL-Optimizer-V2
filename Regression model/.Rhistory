## GHG
ghg<-data %>% filter(Description%in% c("Total CO2e of light-duty vehicles and heavy duty vehicles","Per capita Daily greenhousehouse gas emissions of household vehicles","Per mile Daily greenhousehouse gas emissions of household vehicles","Per mile greenhousehouse gas emissions of household vehicles in urban area","Per mile greenhousehouse gas emissions of household vehicles in town area","Per mile greenhousehouse gas emissions of household vehicles in rural area")) %>%
mutate(Description=case_when(
Description == "Total CO2e of light-duty vehicles and heavy duty vehicles" ~ "Total CO2e - Light/Heavy Duty Vehciles",
Description =="Per capita Daily greenhousehouse gas emissions of household vehicles" ~ "Per Capita Household GHG",
Description == "Per mile Daily greenhousehouse gas emissions of household vehicles" ~ "Per Mile Household GHG",
Description == "Per mile greenhousehouse gas emissions of household vehicles in urban area" ~ "Per Mile Household Urban GHG",
Description == "Per mile greenhousehouse gas emissions of household vehicles in town area" ~ "Per Mile Household Town GHG",
Description =="Per mile greenhousehouse gas emissions of household vehicles in rural area" ~ "Per Mile Household Rural GHG"
)) %>%
pivot_wider(id_cols=Description,names_from=scenario, values_from=percent_change1)
write_clip(ghg)
ghg_data<-ghg %>%
pivot_longer(cols=2:18) %>%
mutate(name=factor(name, level=c("one","two","three","four","five","six","seven","eight","nine","ten","eleven","twelve","thirteen","fourteen","fifteen","sixteen","seventeen")))
ghg_mean<- ghg_data %>%
group_by(Description) %>%
summarise(mean = mean(value)) %>%
mutate(text="AVG")
ghg_data %>%
ggplot(aes(name,value)) +
geom_col(fill = "cornflowerblue",
color = "white") +
geom_hline(data = ghg_mean,aes(yintercept = mean)) +
facet_wrap(~Description, scales="free", ncol=1)+
#labs(title = "GHG Measures (% change from 2015 - 16 Scenarios)") +
scale_y_continuous(labels = scales::percent_format(accuracy=1)) +
xlab("") +
ylab("")
