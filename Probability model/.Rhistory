med_EVs=ifelse(is.na(med_EVs), 0, med_EVs),
med=ifelse(is.na(med), 0, med),
bus_EVs=ifelse(is.na(bus_EVs), 0, bus_EVs),
bus=ifelse(is.na(bus), 0, bus),
Recommended_L2Chargers=ifelse(is.na(Recommended_L2Chargers), 0, Recommended_L2Chargers),
Existing_L2Chargers=ifelse(is.na(Existing_L2Chargers), 0, Existing_L2Chargers),
Recommended_DC_chargers=ifelse(is.na(Recommended_DC_chargers), 0, Recommended_DC_chargers),
Existing_DC_chargers=ifelse(is.na(Existing_DC_chargers), 0, Existing_DC_chargers),
NumTrkSpaces_sum=ifelse(is.na(NumTrkSpaces_sum), 0, NumTrkSpaces_sum),
vehicles_base = vehicles_base + hev + med + bus,
vehicles_2030 = vehicles_base + hev + med + bus,
vehicles_2035 = vehicles_base + hev + med + bus) %>%
st_transform(crs = 26986)
## Apply the EV proportions by year
hexes_save <- hexes_save %>%
mutate(evs_base = round(vehicles_base * (0.01/100) + (hev_EVs + med_EVs + bus_EVs)),
evs_hd_base = round(evs_base * (33.33/100) + hev_EVs),
evs_med_base = round(evs_base * (0/100) + med_EVs),
evs_bus_base = round(evs_base * (66.67/100) + bus_EVs),
evs_2030 = round(vehicles_2030 * (9.06/100) + (hev_EVs + med_EVs + bus_EVs)),
evs_hd_2030 = round(evs_2030 * (12.72/100) + hev_EVs),
evs_md_2030 = round(evs_2030 * (83.76/100) + med_EVs),
evs_bus_2030 = round(evs_2030 * (3.53/100) + bus_EVs),
evs_2035 = round(vehicles_2035 * (24.72/100) + (hev_EVs + med_EVs + bus_EVs)),
evs_hd_2035 = round(evs_2035 * (12.38/100) + hev_EVs),
evs_md_2035 = round(evs_2035 * (84.05/100) + med_EVs),
evs_bus_2030 = round(evs_2030 * (3.56/100) + bus_EVs),
sum_rec_DC_chargers = Recommended_DC_chargers + NumTrkSpaces_sum)
# Now to get the vehicle chargers being used
ratios <- data.frame(vehs = 133808 - sum(fa_data2$hev_EVs, na.rm = T) - sum(fa_data2$med_EVs, na.rm = T) - sum(fa_data2$bus_EVs, na.rm = T),
chrgr_50kw = 67365 - sum(fa_data2$Existing_L2Chargers), chrgr_350kw = 10527-sum(hexes$NumTrkSpaces_sum, na.rm = T)) %>%
mutate(chrgr_50kw = chrgr_50kw/vehs, chrgr_350kw = chrgr_350kw/vehs)
hexes_save <- hexes_save %>%
mutate(pct_share_base = vehicles_base/sum(vehicles_base, na.rm = T),
pct_share_2030 = vehicles_2030/sum(vehicles_2030, na.rm = T),
pct_share_2035 = vehicles_2035/sum(vehicles_2035, na.rm = T),
num_50kw_chargers_base = round(ratios$chrgr_50kw * (evs_base - (hev_EVs + med_EVs + bus_EVs)) + Existing_L2Chargers),
num_50kw_chargers_base = ifelse(hev_EVs + med_EVs + bus_EVs > 0 & Existing_L2Chargers > 0, Existing_L2Chargers, num_50kw_chargers_base),
num_50kw_chargers_2030 = round(ratios$chrgr_50kw * (evs_2030 - (hev_EVs + med_EVs + bus_EVs)) + Recommended_L2Chargers),
num_50kw_chargers_2030 = ifelse(evs_2030==evs_base, num_50kw_chargers_base, num_50kw_chargers_2030),
num_50kw_chargers_2030 = ifelse(num_50kw_chargers_2030 < num_50kw_chargers_base, num_50kw_chargers_base, num_50kw_chargers_2030),
num_50kw_chargers_2035 = round(ratios$chrgr_50kw * (evs_2035 - (hev_EVs + med_EVs + bus_EVs)) + Recommended_L2Chargers),
num_50kw_chargers_2035 = ifelse(evs_2035==evs_base, num_50kw_chargers_base, num_50kw_chargers_2035),
num_50kw_chargers_2035 = ifelse(num_50kw_chargers_2035 < num_50kw_chargers_2030, num_50kw_chargers_2030, num_50kw_chargers_2035),
num_350kw_chargers_base = round(ratios$chrgr_350kw * (evs_base - (hev_EVs + med_EVs + bus_EVs)) + Existing_DC_chargers),
num_350kw_chargers_base = ifelse(hev_EVs + med_EVs + bus_EVs > 0 & Existing_DC_chargers > 0, Existing_DC_chargers, num_350kw_chargers_base),
num_350kw_chargers_base = ifelse(hev_EVs + med_EVs + bus_EVs==0 & evs_base==0, 0, num_350kw_chargers_base),
num_350kw_chargers_2030 = round(ratios$chrgr_350kw * (evs_2030 - hev_EVs + med_EVs + bus_EVs)  + Recommended_DC_chargers),
num_350kw_chargers_2030 = ifelse(evs_2030==evs_base, Recommended_DC_chargers, num_350kw_chargers_2030),
num_350kw_chargers_2030 = ifelse(hev_EVs + med_EVs + bus_EVs==0 & evs_2030==0, 0, num_350kw_chargers_2030),
num_350kw_chargers_2030 = ifelse(Recommended_DC_chargers >= evs_2030, round(ratios$chrgr_350kw * evs_2030), num_350kw_chargers_2030),
num_350kw_chargers_2030 = ifelse(num_350kw_chargers_2030 < num_350kw_chargers_base, num_350kw_chargers_base, num_350kw_chargers_2030),
num_350kw_chargers_2035=round(ratios$chrgr_350kw * (evs_2035 - hev_EVs + med_EVs + bus_EVs)  + Recommended_DC_chargers),
num_350kw_chargers_2035 = ifelse(evs_2035==evs_base, Recommended_DC_chargers, num_350kw_chargers_2035),
num_350kw_chargers_2035 = ifelse(hev_EVs + med_EVs + bus_EVs==0 & evs_2035==0, 0, num_350kw_chargers_2035),
num_350kw_chargers_2035 = ifelse(Recommended_DC_chargers >= evs_2035/2, round(ratios$chrgr_350kw * evs_2035), num_350kw_chargers_2035),
num_350kw_chargers_2035 = ifelse(num_350kw_chargers_2035 < num_350kw_chargers_2030, num_350kw_chargers_2030, num_350kw_chargers_2035),
vehicles_base = vehicles_base + hev_EVs + med_EVs + bus_EVs,
vehicles_2030 = vehicles_2030 + hev_EVs + med_EVs + bus_EVs,
vehicles_2035 = vehicles_2035 + hev_EVs + med_EVs + bus_EVs) %>%
rename(Hev_EVs_existing = hev_EVs,
Med_EVs_existing = med_EVs,
Bus_EVs_existing = bus_EVs,
Hev_existing = hev,
Med_existing = med,
Bus_existing = bus)
View(hexes_save)
## Save the spatial files - DELETE THE PREVIOUS GEOJSONS
st_write(hexes_save, '../../Data/Shapefiles/hexes_chargers.geojson', append = F)
#---------------------------------------#
# Run script for FPL Lineup Optimizer
# Written by: ncfisher
# Last updated: June 23 2026
#---------------------------------------#
# This script is used to run the FPL optimizer model and Probability distribution
# model.
#
# The Probability model uses weighted probabilities to calculate the likelihood
# of FPL scoring events occurring within a match.
#
# Probability model run time: ~ 20 minutes
#
# To use the models, press control + enter on each command below. This may require
# installation of several R packages.
packages <- c('tidyverse', 'worldfootballR', 'randomForest', 'rstudioapi',
'httr', 'jsonlite', 'openxlsx', 'data.table', 'rvest',
'stringdist', 'stats', 'fuzzyjoin', 'stringi')
for (package in packages) {
if (!requireNamespace(package, quietly = T)) {
install.packages(package, dependencies = T)
}
library(package, character.only = T)
cat(paste(package, "package loaded.\n"))
}
setwd(dirname(getActiveDocumentContext()$path))
#---------------------------------------#
